# Copy this file to terraform.tfvars for local Terraform.
# OCI Resource Manager users can enter the same values as stack variables.

tenancy_ocid     = "ocid1.tenancy.oc1..replace"
compartment_ocid = "ocid1.compartment.oc1..replace"
region           = "us-ashburn-1"
project_name     = "firsttrace"

# First apply:
# container_image_url = ""
#
# After building and pushing the image to OCIR, set:
# container_image_url = "<region-key>.ocir.io/<namespace>/firsttrace:latest"
container_image_url = ""

config_path = "firsttrace.config.yaml"

# OCI-native AI inference. Override ai_model with a model available in your
# selected OCI GenAI region, or set ai_provider = "openai" and add OPENAI_API_KEY
# to runtime_secret_names when direct OpenAI API use is intentional.
ai_provider = "oci-genai"
ai_enabled  = false
ai_model    = "openai.gpt-5-codex"

# Optional provider request controls. Leave unset unless the selected model
# requires a request parameter. Use *_field = "none" to omit a control, or an
# explicit provider field path such as maxCompletionTokens when auto is wrong.
ai_output_token_limit       = ""
ai_output_token_limit_field = "auto"
ai_temperature              = ""
ai_temperature_field        = "auto"
ai_reasoning_effort         = ""
ai_reasoning_effort_field   = "auto"
ai_verbosity                = ""
ai_verbosity_field          = "auto"
ai_top_p                    = ""
ai_top_p_field              = "auto"
ai_top_k                    = ""
ai_top_k_field              = "auto"
ai_stop_sequences           = ""
ai_stop_sequences_field     = "auto"
ai_store                    = ""
ai_store_field              = "auto"
ai_request_extra_json       = ""

# Use only when you deploy a dedicated OCI GenAI endpoint.
oci_genai_dedicated_endpoint_id = ""

# Leave empty to use the runtime region. Set this to a subscribed OCI GenAI
# model region when the runtime region does not host the selected model.
oci_genai_region = ""

# For a first health-check-only bootstrap, you can set both to false, apply,
# verify /healthz, then create secrets and turn them back on.
enable_vault_secret_loading = true
oci_vault_secrets_required  = true

# Leave empty to let Terraform create a new Vault KMS key. Set this to a
# pre-approved OCI Vault key OCID when your tenancy requires reusing managed keys.
existing_kms_key_ocid = ""

# Runtime Vault secret profile. Use bootstrap before secrets exist,
# slack-minimal for Slack-only/archive setups, github-repos for GitHub App
# repository access, or direct-openai when ai_provider = "openai".
secret_profile = "github-repos"
